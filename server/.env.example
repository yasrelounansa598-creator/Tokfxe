# Server-only secrets. Never commit real values.
PORT=8787
ALLOWED_ORIGINS=http://localhost:3000,https://your-fextok-domain.example

# Firebase Admin service account JSON, stored as a hosting-platform secret.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_FIREBASE_PROJECT_ID"}

# LiveKit server credentials. Keep the API secret out of the frontend and GitHub.
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
LIVEKIT_URL=wss://your-project.livekit.cloud
