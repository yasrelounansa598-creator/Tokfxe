<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Glowing Background Aura -->
    <path
        android:pathData="M100,100m-70,0a70,70 0 1,0 140,0a70,70 0 1,0 -140,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="75"
                android:type="radial"
                android:startColor="#4000D9FF"
                android:centerColor="#208A2BFF"
                android:endColor="#0005070B" />
        </aapt:attr>
    </path>

    <!-- Squircle Border with Neon Gradient -->
    <path
        android:pathData="M100,20 C150,20 180,50 180,100 C180,150 150,180 100,180 C50,180 20,150 20,100 C20,50 50,20 100,20 Z"
        android:strokeWidth="2.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="180"
                android:endY="180"
                android:type="linear">
                <item android:offset="0.0" android:color="#00D9FF" />
                <item android:offset="0.5" android:color="#8A2BFF" />
                <item android:offset="1.0" android:color="#FF00A8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- F Monogram Stem -->
    <path
        android:pathData="M65,58 L80,58 C83,58 85,60 85,63 L85,137 C85,140 83,142 80,142 L65,142 C62,142 60,140 60,137 L60,63 C60,60 62,58 65,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="60"
                android:startY="58"
                android:endX="85"
                android:endY="142"
                android:type="linear">
                <item android:offset="0.0" android:color="#00D9FF" />
                <item android:offset="1.0" android:color="#8A2BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top F Bar -->
    <path
        android:pathData="M85,58 L125,58 C128,58 130,60 130,63 L130,73 C130,76 128,78 125,78 L85,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="85"
                android:startY="58"
                android:endX="130"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#00D9FF" />
                <item android:offset="1.0" android:color="#8A2BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Middle F Bar -->
    <path
        android:pathData="M85,88 L115,88 C117.5,88 119.5,90 119.5,92.5 L119.5,98.5 C119.5,101 117.5,103 115,103 L85,103 Z"
        android:fillColor="#8A2BFF" />

    <!-- Dynamic Diagonal X Leg -->
    <path
        android:pathData="M78,140 L102,105 L136,140 L122,140 L97,113 L86,126 L86,140 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="78"
                android:startY="105"
                android:endX="136"
                android:endY="140"
                android:type="linear">
                <item android:offset="0.0" android:color="#8A2BFF" />
                <item android:offset="1.0" android:color="#FF00A8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Play Triangle Core -->
    <path
        android:pathData="M106,78 C106,75.5 108.5,74 110.5,75.2 L137,90.5 C139,91.7 139,94.3 137,95.5 L110.5,110.8 C108.5,112 106,110.5 106,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="106"
                android:startY="75"
                android:endX="139"
                android:endY="112"
                android:type="linear">
                <item android:offset="0.0" android:color="#00D9FF" />
                <item android:offset="0.5" android:color="#FF00A8" />
                <item android:offset="1.0" android:color="#FF00A8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sharp White Play Highlight -->
    <path
        android:pathData="M112,85 L112,101 L127,93 Z"
        android:fillColor="#FFFFFF" />

    <!-- Kinetic Digital Sparks -->
    <path
        android:pathData="M140,70 L148,70 C149,70 150,71 150,72 L150,72 C150,73 149,74 148,74 L140,74 Z"
        android:fillColor="#00D9FF" />
    <path
        android:pathData="M142,80 L152,80 C153,80 154,81 154,82 L154,82 C154,83 153,84 152,84 L142,84 Z"
        android:fillColor="#FF00A8" />
</vector>
