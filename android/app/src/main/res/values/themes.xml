<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tok Fxe Main Dark Neon Theme -->
    <style name="Theme.TokFxe" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#05070B</item>
        <item name="android:navigationBarColor">#05070B</item>
        <item name="android:windowBackground">#05070B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Tok Fxe Launch Splash Screen Theme -->
    <style name="Theme.TokFxe.Splash" parent="Theme.TokFxe">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- Compatibility Aliases -->
    <style name="Theme.FexTok" parent="Theme.TokFxe" />
</resources>
